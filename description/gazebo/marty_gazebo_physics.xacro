<?xml version="1.0"?>
<!-- Gazebo (gz-sim) physics + surface tuning for Marty v2, included only when
     use_gazebo_sim:=true. The gz_ros2_control plugin lives in the generated
     description/gazebo/gazebo.xacro. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Pin the body to the world: the upstream model has no real masses, so it cannot balance or walk. -->
  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <!-- Feet bottoms sit 0.15338 m below base_link at the zero pose; lift so they rest on the ground. -->
    <origin xyz="0 0 0.15338" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="gazebo_foot" params="link">
    <gazebo reference="${link}">
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <kp>1e6</kp>
      <kd>10</kd>
    </gazebo>
  </xacro:macro>

  <xacro:gazebo_foot link="foot_left"/>
  <xacro:gazebo_foot link="foot_right"/>
</robot>
